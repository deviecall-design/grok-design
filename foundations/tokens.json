{
  "$description": "Shared foundations for Deviecall ventures. A kit overrides these values. It does not invent a parallel system. Token key 'color' follows the CSS and W3C spelling.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.ink", "color.bg", 4.5],
      ["color.ink", "color.surface", 4.5],
      ["color.muted", "color.bg", 4.5],
      ["color.muted", "color.surface", 4.5],
      ["color.on-accent", "color.accent", 4.5],
      ["color.accent", "color.bg", 4.5],
      ["color.accent", "color.surface", 4.5],
      ["color.danger", "color.bg", 4.5],
      ["color.danger", "color.surface", 4.5],
      ["color.warning", "color.bg", 4.5],
      ["color.warning", "color.surface", 4.5],
      ["color.success", "color.bg", 4.5],
      ["color.success", "color.surface", 4.5],
      ["color.focus", "color.bg", 3],
      ["color.focus", "color.surface", 3],
      ["color.line", "color.bg", 3],
      ["color.line", "color.surface", 3]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#f3efe6",
      "$description": "Page background. Warm paper."
    },
    "surface": {
      "$type": "color",
      "$value": "#faf8f4",
      "$description": "A raised surface. Still paper, a step lighter."
    },
    "ink": {
      "$type": "color",
      "$value": "#1c1915",
      "$description": "Primary text."
    },
    "muted": {
      "$type": "color",
      "$value": "#5c564e",
      "$description": "Secondary text. Meets AA on bg and surface."
    },
    "line": {
      "$type": "color",
      "$value": "#8a8175",
      "$description": "Borders and dividers that carry structure."
    },
    "accent": {
      "$type": "color",
      "$value": "#3e4c38",
      "$description": "The single accent. Deep olive. Use rarely."
    },
    "on-accent": {
      "$type": "color",
      "$value": "#f4f1e8",
      "$description": "Text and icons on an accent fill."
    },
    "danger": {
      "$type": "color",
      "$value": "#8d2c22",
      "$description": "Text for a real error or destructive state."
    },
    "warning": {
      "$type": "color",
      "$value": "#7a4e0d",
      "$description": "Text for a caution state."
    },
    "success": {
      "$type": "color",
      "$value": "#21543c",
      "$description": "Text for a confirmed positive state."
    },
    "focus": {
      "$type": "color",
      "$value": "#2c4530",
      "$description": "Focus ring. Visible immediately."
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "serif"],
        "$description": "Quiet serif for short headings. System faces only."
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "UI and body text."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
        "$description": "Figures, codes, and identifiers."
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "12px. Specimen meta only. Not for product body."
      },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Body. Do not go smaller for product UI."
      },
      "lg": { "$type": "dimension", "$value": "1.25rem" },
      "xl": { "$type": "dimension", "$value": "1.5rem" },
      "2xl": { "$type": "dimension", "$value": "2rem" },
      "3xl": { "$type": "dimension", "$value": "2.75rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.15 },
      "dense": { "$type": "number", "$value": 1.35 },
      "body": { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" }
  },
  "size": {
    "touch": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Minimum width and height of a control that is pressed."
    }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "2px" },
    "md": { "$type": "dimension", "$value": "4px" },
    "lg": { "$type": "dimension", "$value": "8px" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "0ms" },
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "280ms" }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1],
        "$description": "Settle. No bounce, no elastic."
      }
    }
  },
  "elevation": {
    "flat": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Default. Use a border instead."
    },
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "#1c191514",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      },
      "$description": "Only a surface that floats, such as a dialog."
    }
  }
}
