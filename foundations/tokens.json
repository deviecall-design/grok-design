{
  "$description": "Shared foundations for Deviecall ventures. Colours are OKLCH. $extensions.deviecall.dark is the dark mode. A kit overrides these values.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.ink",
        "color.bg",
        4.5
      ],
      [
        "color.ink",
        "color.surface",
        4.5
      ],
      [
        "color.muted",
        "color.bg",
        4.5
      ],
      [
        "color.muted",
        "color.surface",
        4.5
      ],
      [
        "color.on-accent",
        "color.accent",
        4.5
      ],
      [
        "color.accent",
        "color.bg",
        4.5
      ],
      [
        "color.accent",
        "color.surface",
        4.5
      ],
      [
        "color.danger",
        "color.bg",
        4.5
      ],
      [
        "color.danger",
        "color.surface",
        4.5
      ],
      [
        "color.warning",
        "color.bg",
        4.5
      ],
      [
        "color.warning",
        "color.surface",
        4.5
      ],
      [
        "color.success",
        "color.bg",
        4.5
      ],
      [
        "color.success",
        "color.surface",
        4.5
      ],
      [
        "color.focus",
        "color.bg",
        3
      ],
      [
        "color.focus",
        "color.surface",
        3
      ],
      [
        "color.line",
        "color.bg",
        3
      ],
      [
        "color.line",
        "color.surface",
        3
      ],
      [
        "color.info",
        "color.bg",
        4.5
      ],
      [
        "color.info",
        "color.surface",
        4.5
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(96.8% 0.009 92)",
      "$extensions": {
        "deviecall.dark": "oklch(20% 0.01 92)"
      },
      "$description": "Warm stone page."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(98.6% 0.006 92)",
      "$extensions": {
        "deviecall.dark": "oklch(24.2% 0.01 92)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(24.5% 0.014 80)",
      "$extensions": {
        "deviecall.dark": "oklch(94.2% 0.008 92)"
      },
      "$description": "Primary text."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(42.5% 0.014 80)",
      "$extensions": {
        "deviecall.dark": "oklch(78.5% 0.012 92)"
      },
      "$description": "Secondary text."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(60% 0.014 88)",
      "$extensions": {
        "deviecall.dark": "oklch(60% 0.012 92)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(37.5% 0.052 148)",
      "$extensions": {
        "deviecall.dark": "oklch(80.5% 0.055 148)"
      },
      "$description": "Deep pine. The only chromatic accent."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(97.2% 0.008 95)",
      "$extensions": {
        "deviecall.dark": "oklch(22% 0.025 148)"
      },
      "$description": "Text on the accent fill."
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(45.5% 0.13 27)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.09 27)"
      },
      "$description": "Error text. Pair with a word."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.1 72)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.08 78)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(42% 0.07 158)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.06 158)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(44% 0.04 232)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.035 232)"
      },
      "$description": "Quiet steel. Not a primary blue."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(36% 0.05 148)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.05 148)"
      },
      "$description": "Focus ring."
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Iowan Old Style",
          "Palatino Linotype",
          "Palatino",
          "Georgia",
          "serif"
        ],
        "$description": "Quiet serif for short headings. System faces only."
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "UI and body text."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Figures, codes, and identifiers."
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "12px. Specimen meta only. Not for product body."
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Body. Do not go smaller for product UI."
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "2.75rem"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "leading": {
      "tight": {
        "$type": "number",
        "$value": 1.15
      },
      "dense": {
        "$type": "number",
        "$value": 1.35
      },
      "body": {
        "$type": "number",
        "$value": 1.5
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    },
    "9": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "size": {
    "touch": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Minimum width and height of a control that is pressed."
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "2px"
    },
    "md": {
      "$type": "dimension",
      "$value": "4px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "0ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "180ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "280ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Settle. No bounce, no elastic."
      }
    }
  },
  "elevation": {
    "flat": {
      "$type": "shadow",
      "$value": {
        "color": "oklch(0% 0 0 / 0)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Default. Use a border instead."
    },
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "oklch(24% 0.012 85 / 0.08)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      },
      "$description": "Only a surface that floats, such as a dialog.",
      "$extensions": {
        "deviecall.dark": {
          "color": "oklch(0% 0 0 / 0.5)",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px"
        }
      }
    }
  }
}
