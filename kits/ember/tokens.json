{
  "$description": "Ember. Civil emergency response. High-clarity situational UI. Simulated and live are different labels. Red is reserved for live.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.status.live.fg",
        "color.status.live.bg",
        4.5
      ],
      [
        "color.status.simulated.fg",
        "color.status.simulated.bg",
        4.5
      ],
      [
        "color.viz.1",
        "color.bg",
        3
      ],
      [
        "color.viz.1",
        "color.surface",
        3
      ],
      [
        "color.viz.2",
        "color.bg",
        3
      ],
      [
        "color.viz.2",
        "color.surface",
        3
      ],
      [
        "color.viz.3",
        "color.bg",
        3
      ],
      [
        "color.viz.3",
        "color.surface",
        3
      ],
      [
        "color.viz.4",
        "color.bg",
        3
      ],
      [
        "color.viz.4",
        "color.surface",
        3
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(96.8% 0.008 70)",
      "$extensions": {
        "deviecall.dark": "oklch(18% 0.012 55)"
      },
      "$description": "Warm field. Dark mode stays a field, not a glow."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(98.8% 0.005 70)",
      "$extensions": {
        "deviecall.dark": "oklch(23% 0.012 55)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(22% 0.016 50)",
      "$extensions": {
        "deviecall.dark": "oklch(95% 0.008 80)"
      },
      "$description": "Primary text."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(42% 0.016 55)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.014 70)"
      },
      "$description": "Secondary text."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(55% 0.014 60)",
      "$extensions": {
        "deviecall.dark": "oklch(60% 0.012 60)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(22% 0.016 50)",
      "$extensions": {
        "deviecall.dark": "oklch(95% 0.008 80)"
      },
      "$description": "Same as ink, so a button is never red."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(96.8% 0.008 70)",
      "$extensions": {
        "deviecall.dark": "oklch(18% 0.012 55)"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(44% 0.14 28)",
      "$extensions": {
        "deviecall.dark": "oklch(76% 0.12 28)"
      },
      "$description": "Inline danger text. Not a button colour."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.09 72)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.08 75)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(40% 0.07 158)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.055 160)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(42% 0.035 230)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.03 225)"
      },
      "$description": "Informational text. Low chroma, never the accent."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(22% 0.016 50)",
      "$extensions": {
        "deviecall.dark": "oklch(95% 0.008 80)"
      },
      "$description": "Focus ring."
    },
    "status": {
      "live": {
        "bg": {
          "$type": "color",
          "$value": "oklch(42% 0.14 28)",
          "$extensions": {
            "deviecall.dark": "oklch(55% 0.15 28)"
          },
          "$description": "LIVE label fill. Reserved."
        },
        "fg": {
          "$type": "color",
          "$value": "oklch(97.5% 0.008 40)",
          "$extensions": {
            "deviecall.dark": "oklch(97% 0.008 80)"
          },
          "$description": "LIVE label text."
        }
      },
      "simulated": {
        "bg": {
          "$type": "color",
          "$value": "oklch(98.8% 0.005 70)",
          "$extensions": {
            "deviecall.dark": "oklch(23% 0.012 55)"
          },
          "$description": "SIMULATED label fill. Draw a 2px ink border."
        },
        "fg": {
          "$type": "color",
          "$value": "oklch(22% 0.016 50)",
          "$extensions": {
            "deviecall.dark": "oklch(95% 0.008 80)"
          },
          "$description": "SIMULATED label text."
        }
      }
    },
    "viz": {
      "1": {
        "$type": "color",
        "$value": "oklch(40% 0.03 60)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.03 65)"
        },
        "$description": "Magnitude series. Stone. Not the live red."
      },
      "2": {
        "$type": "color",
        "$value": "oklch(46% 0.07 80)",
        "$extensions": {
          "deviecall.dark": "oklch(80% 0.06 82)"
        },
        "$description": "Magnitude series. Ochre."
      },
      "3": {
        "$type": "color",
        "$value": "oklch(40% 0.05 155)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.045 155)"
        },
        "$description": "Magnitude series. Pine."
      },
      "4": {
        "$type": "color",
        "$value": "oklch(42% 0.03 220)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.028 220)"
        },
        "$description": "Magnitude series. Steel."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Same family as body. No display costume."
      }
    },
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Smallest product size. 16px."
      },
      "md": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "Body. 18px."
      }
    }
  },
  "elevation": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "oklch(0% 0 0 / 0)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "No shadow. A floating panel uses a border, not a glow."
    }
  }
}
