{
  "$description": "Ember. Civil emergency response. High-clarity situational UI. Simulated and live are different labels. Red is reserved for live.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.status.live.fg", "color.status.live.bg", 4.5],
      ["color.status.simulated.fg", "color.status.simulated.bg", 4.5]
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#f6f3ef", "$description": "Field paper. Light, for glare and fatigue." },
    "surface": { "$type": "color", "$value": "#fffdfb", "$description": "Panel." },
    "ink": { "$type": "color", "$value": "#1a120c", "$description": "Primary text, and the action colour." },
    "muted": { "$type": "color", "$value": "#5c5148", "$description": "Secondary text." },
    "line": { "$type": "color", "$value": "#7d756c", "$description": "Strong structural rules." },
    "accent": { "$type": "color", "$value": "#1a120c", "$description": "Same as ink. Actions are black so red stays free for live." },
    "on-accent": { "$type": "color", "$value": "#f6f3ef", "$description": "Text on an ink fill." },
    "danger": { "$type": "color", "$value": "#8f2618", "$description": "Inline text for a dangerous condition. Not a button colour." },
    "warning": { "$type": "color", "$value": "#7a4e0d", "$description": "Watch text. Pair with the word Watch." },
    "success": { "$type": "color", "$value": "#1b5c40", "$description": "Clear text. Pair with the word Clear." },
    "focus": { "$type": "color", "$value": "#1a120c", "$description": "Focus ring." },
    "status": {
      "live": {
        "bg": { "$type": "color", "$value": "#8f2618", "$description": "LIVE label fill. Reserved." },
        "fg": { "$type": "color", "$value": "#fff8f5", "$description": "LIVE label text." }
      },
      "simulated": {
        "bg": { "$type": "color", "$value": "#fffdfb", "$description": "SIMULATED label fill. Use with an ink border." },
        "fg": { "$type": "color", "$value": "#1a120c", "$description": "SIMULATED label text." }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Same family as body. No display costume."
      }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": "1rem", "$description": "Smallest product size. 16px." },
      "md": { "$type": "dimension", "$value": "1.125rem", "$description": "Body. 18px." }
    }
  },
  "elevation": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "No shadow. A floating panel uses a border, not a glow."
    }
  }
}
