{
  "$description": "Electrascan. High-legibility UI for electrical trade work on site. Strong contrast, large type, hazard colour reserved for hazard.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.hazard.fg", "color.hazard.bg", 4.5]
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#f7f4ee", "$description": "Site paper. Light, so it survives sun." },
    "surface": { "$type": "color", "$value": "#ffffff", "$description": "Card and sheet surface." },
    "ink": { "$type": "color", "$value": "#121212", "$description": "Primary text. Near black." },
    "muted": { "$type": "color", "$value": "#3a3a3a", "$description": "Secondary text, still dark enough outdoors." },
    "line": { "$type": "color", "$value": "#7d776e", "$description": "Strong rules. A faint grey disappears on site." },
    "accent": { "$type": "color", "$value": "#0e3a4d", "$description": "Workwear navy. Primary actions." },
    "on-accent": { "$type": "color", "$value": "#f7f4ee", "$description": "Text on the navy fill." },
    "danger": { "$type": "color", "$value": "#8a2e16", "$description": "Inline fault text on paper." },
    "warning": { "$type": "color", "$value": "#7a4e0d", "$description": "Inline caution text on paper." },
    "success": { "$type": "color", "$value": "#21543c", "$description": "Confirmed text, such as a passed check." },
    "focus": { "$type": "color", "$value": "#0e3a4d", "$description": "Focus ring." },
    "hazard": {
      "bg": { "$type": "color", "$value": "#f0c014", "$description": "Hazard band fill. Not a brand colour." },
      "fg": { "$type": "color", "$value": "#121212", "$description": "Text on the hazard band." }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Same family as body."
      }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": "1rem", "$description": "Smallest product size on site. 16px." },
      "md": { "$type": "dimension", "$value": "1.125rem", "$description": "Body on site. 18px." },
      "lg": { "$type": "dimension", "$value": "1.375rem" },
      "xl": { "$type": "dimension", "$value": "1.75rem" }
    }
  }
}
