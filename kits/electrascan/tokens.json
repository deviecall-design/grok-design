{
  "$description": "Electrascan. High-legibility UI for electrical trade work on site. Strong contrast, large type, hazard colour reserved for hazard.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.hazard.fg",
        "color.hazard.bg",
        4.5
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(98.2% 0.004 220)",
      "$extensions": {
        "deviecall.dark": "oklch(16% 0.006 95)"
      },
      "$description": "Cool instrument field for sun. Dark is for a dim board."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "deviecall.dark": "oklch(21% 0.006 95)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(18% 0 0)",
      "$extensions": {
        "deviecall.dark": "oklch(96.5% 0.004 95)"
      },
      "$description": "Near-black in light, near-white in dark."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(32% 0.006 95)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.008 95)"
      },
      "$description": "Still dark enough to read outdoors, and still strong in the dark mode."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(50% 0.012 90)",
      "$extensions": {
        "deviecall.dark": "oklch(60% 0.01 95)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(32% 0.04 220)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.04 215)"
      },
      "$description": "Low-chroma navy. Not a bright blue."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(98.2% 0.004 220)",
      "$extensions": {
        "deviecall.dark": "oklch(16% 0.02 220)"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(44% 0.14 30)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.1 30)"
      },
      "$description": "Error text. Pair with a word."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.09 72)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.08 75)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(40% 0.07 155)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.06 155)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(40% 0.04 230)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.035 225)"
      },
      "$description": "Informational text. Low chroma, never the accent."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(32% 0.04 220)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.045 215)"
      },
      "$description": "Focus ring."
    },
    "hazard": {
      "bg": {
        "$type": "color",
        "$value": "oklch(86% 0.15 95)",
        "$extensions": {
          "deviecall.dark": "oklch(86% 0.15 95)"
        },
        "$description": "Hazard band. Same yellow in both modes. Not a brand colour."
      },
      "fg": {
        "$type": "color",
        "$value": "oklch(18% 0 0)",
        "$extensions": {
          "deviecall.dark": "oklch(16% 0 0)"
        },
        "$description": "Text on the hazard band."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Same family as body."
      }
    },
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Smallest product size on site. 16px."
      },
      "md": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "Body on site. 18px."
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.375rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.75rem"
      }
    }
  }
}
