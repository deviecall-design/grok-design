{
  "$description": "Mirofish. Dark terminal for paper and simulated markets. Cool green-black field, one olive accent, monospace figures.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.status.paper.fg",
        "color.status.paper.bg",
        4.5
      ],
      [
        "color.viz.1",
        "color.bg",
        3
      ],
      [
        "color.viz.1",
        "color.surface",
        3
      ],
      [
        "color.viz.2",
        "color.bg",
        3
      ],
      [
        "color.viz.2",
        "color.surface",
        3
      ],
      [
        "color.viz.3",
        "color.bg",
        3
      ],
      [
        "color.viz.3",
        "color.surface",
        3
      ],
      [
        "color.viz.4",
        "color.bg",
        3
      ],
      [
        "color.viz.4",
        "color.surface",
        3
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(96.2% 0.012 165)",
      "$extensions": {
        "deviecall.dark": "oklch(16.2% 0.016 160)"
      },
      "$description": "Cool field. Dark is the working terminal. Light is the same terminal on mist paper."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(98% 0.008 165)",
      "$extensions": {
        "deviecall.dark": "oklch(21% 0.018 160)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(24% 0.02 165)",
      "$extensions": {
        "deviecall.dark": "oklch(93.5% 0.014 155)"
      },
      "$description": "Primary text."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(42% 0.02 165)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.02 155)"
      },
      "$description": "Secondary text."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(56% 0.02 165)",
      "$extensions": {
        "deviecall.dark": "oklch(58% 0.018 160)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(38% 0.055 132)",
      "$extensions": {
        "deviecall.dark": "oklch(84% 0.05 128)"
      },
      "$description": "Olive. Rare. Not a profit colour."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(97% 0.01 150)",
      "$extensions": {
        "deviecall.dark": "oklch(20% 0.02 140)"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(46% 0.12 28)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.07 25)"
      },
      "$description": "Error text. Pair with a word."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.1 75)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.07 80)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(42% 0.055 162)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.05 165)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(44% 0.035 220)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.03 210)"
      },
      "$description": "Informational text. Low chroma, never the accent."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(38% 0.055 132)",
      "$extensions": {
        "deviecall.dark": "oklch(84% 0.05 128)"
      },
      "$description": "Focus ring."
    },
    "status": {
      "paper": {
        "bg": {
          "$type": "color",
          "$value": "oklch(22% 0.016 165)",
          "$extensions": {
            "deviecall.dark": "oklch(92% 0.012 150)"
          },
          "$description": "Paper label fill. Neutral, not the olive."
        },
        "fg": {
          "$type": "color",
          "$value": "oklch(96.2% 0.01 165)",
          "$extensions": {
            "deviecall.dark": "oklch(16.2% 0.016 160)"
          },
          "$description": "Paper label text."
        }
      }
    },
    "viz": {
      "1": {
        "$type": "color",
        "$value": "oklch(38% 0.05 132)",
        "$extensions": {
          "deviecall.dark": "oklch(82% 0.05 130)"
        },
        "$description": "First chart series. Olive."
      },
      "2": {
        "$type": "color",
        "$value": "oklch(40% 0.045 175)",
        "$extensions": {
          "deviecall.dark": "oklch(80% 0.04 175)"
        },
        "$description": "Second chart series. Cooler green."
      },
      "3": {
        "$type": "color",
        "$value": "oklch(42% 0.03 95)",
        "$extensions": {
          "deviecall.dark": "oklch(80% 0.03 95)"
        },
        "$description": "Third chart series. Stone."
      },
      "4": {
        "$type": "color",
        "$value": "oklch(42% 0.03 220)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.028 215)"
        },
        "$description": "Fourth chart series. Dull steel."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Same family as body. Figures use font.family.mono."
      }
    }
  },
  "elevation": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "oklch(0% 0 0 / 0)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "No shadow. Separate surfaces with color.line."
    }
  }
}
