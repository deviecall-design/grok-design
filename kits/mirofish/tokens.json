{
  "$description": "Mirofish. Dark terminal for paper and simulated markets. Cool green-black field, one olive accent, monospace figures.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.status.paper.fg", "color.status.paper.bg", 4.5]
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#101412", "$description": "Near-black field with a green cast." },
    "surface": { "$type": "color", "$value": "#1a201c", "$description": "Panel, a step above the field." },
    "ink": { "$type": "color", "$value": "#e8f0ea", "$description": "Primary text." },
    "muted": { "$type": "color", "$value": "#a8b8ac", "$description": "Secondary text." },
    "line": { "$type": "color", "$value": "#6d7b73", "$description": "Row and panel rules." },
    "accent": { "$type": "color", "$value": "#c5d4a4", "$description": "Olive. Rare fill, not a profit colour." },
    "on-accent": { "$type": "color", "$value": "#141a16", "$description": "Text on the olive fill." },
    "danger": { "$type": "color", "$value": "#f0b4ac", "$description": "Loss or error text. Pair with a word or a sign." },
    "warning": { "$type": "color", "$value": "#e7b98a", "$description": "Caution text." },
    "success": { "$type": "color", "$value": "#9dccb0", "$description": "Gain text. Pair with a word or a sign." },
    "focus": { "$type": "color", "$value": "#c5d4a4", "$description": "Focus ring." },
    "status": {
      "paper": {
        "bg": { "$type": "color", "$value": "#e8f0ea", "$description": "Paper label fill. Neutral, not olive." },
        "fg": { "$type": "color", "$value": "#101412", "$description": "Paper label text." }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Same family as body. Figures use font.family.mono."
      }
    }
  },
  "elevation": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "No shadow. Separate surfaces with color.line."
    }
  }
}
