{
  "$description": "Matakite. Rugby analytics with an original palette. No union, team, or fern branding.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.series.a",
        "color.bg",
        4.5
      ],
      [
        "color.series.a",
        "color.surface",
        4.5
      ],
      [
        "color.series.b",
        "color.bg",
        4.5
      ],
      [
        "color.series.b",
        "color.surface",
        4.5
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(96.6% 0.008 90)",
      "$extensions": {
        "deviecall.dark": "oklch(20% 0.02 255)"
      },
      "$description": "Warm paper in light. Navy night in dark, not a black jersey."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(98.8% 0.005 90)",
      "$extensions": {
        "deviecall.dark": "oklch(24.5% 0.02 255)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(28% 0.025 255)",
      "$extensions": {
        "deviecall.dark": "oklch(94% 0.012 90)"
      },
      "$description": "Navy ink in light. Warm paper text in dark, not silver."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(42% 0.016 80)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.014 90)"
      },
      "$description": "Secondary text."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(58% 0.012 85)",
      "$extensions": {
        "deviecall.dark": "oklch(62% 0.012 255)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(42% 0.09 35)",
      "$extensions": {
        "deviecall.dark": "oklch(74% 0.08 38)"
      },
      "$description": "Clay. Original. Not a team colour."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(96.6% 0.008 90)",
      "$extensions": {
        "deviecall.dark": "oklch(22% 0.02 35)"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(46% 0.12 28)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.08 27)"
      },
      "$description": "Error text. Pair with a word."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.1 72)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.075 75)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(42% 0.06 160)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.05 160)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(42% 0.035 230)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.03 225)"
      },
      "$description": "Informational text. Low chroma, never the accent."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(42% 0.09 35)",
      "$extensions": {
        "deviecall.dark": "oklch(76% 0.08 38)"
      },
      "$description": "Focus ring."
    },
    "series": {
      "a": {
        "$type": "color",
        "$value": "oklch(42% 0.09 35)",
        "$extensions": {
          "deviecall.dark": "oklch(74% 0.08 38)"
        },
        "$description": "First series. Clay."
      },
      "b": {
        "$type": "color",
        "$value": "oklch(40% 0.05 195)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.048 195)"
        },
        "$description": "Second series. Deep teal."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Same family as body. Not a poster face."
      }
    }
  }
}
