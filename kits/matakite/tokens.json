{
  "$description": "Matakite. Rugby analytics with an original palette. No union, team, or fern branding.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.series.a", "color.bg", 4.5],
      ["color.series.a", "color.surface", 4.5],
      ["color.series.b", "color.bg", 4.5],
      ["color.series.b", "color.surface", 4.5]
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#f5f3ee", "$description": "Paper. Not a jersey black." },
    "surface": { "$type": "color", "$value": "#fffcf8", "$description": "Table and chart surface." },
    "ink": { "$type": "color", "$value": "#1e2836", "$description": "Primary text. Navy ink, not black-and-silver." },
    "muted": { "$type": "color", "$value": "#4a5564", "$description": "Secondary text." },
    "line": { "$type": "color", "$value": "#7c7870", "$description": "Table rules." },
    "accent": { "$type": "color", "$value": "#7d3a2c", "$description": "Clay. The only brand accent. Also series A." },
    "on-accent": { "$type": "color", "$value": "#f5f3ee", "$description": "Text on the clay fill." },
    "danger": { "$type": "color", "$value": "#8d2c22", "$description": "Error text." },
    "warning": { "$type": "color", "$value": "#7a4e0d", "$description": "Caution text." },
    "success": { "$type": "color", "$value": "#21543c", "$description": "Confirmed text." },
    "focus": { "$type": "color", "$value": "#7d3a2c", "$description": "Focus ring." },
    "series": {
      "a": { "$type": "color", "$value": "#7d3a2c", "$description": "First data series. Clay. Not a team colour." },
      "b": { "$type": "color", "$value": "#1f4f52", "$description": "Second data series. Deep teal. Not a team colour." }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Same family as body. Not a poster face."
      }
    }
  }
}
