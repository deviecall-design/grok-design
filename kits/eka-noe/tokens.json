{
  "$description": "Eka Noe. Dark terminal for paper and simulated markets. Warm black field, brass accent, monospace figures. Not The Bond.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.status.paper.fg", "color.status.paper.bg", 4.5]
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#141310", "$description": "Warm near-black field." },
    "surface": { "$type": "color", "$value": "#1e1c17", "$description": "Panel, a step above the field." },
    "ink": { "$type": "color", "$value": "#f4efe6", "$description": "Primary text." },
    "muted": { "$type": "color", "$value": "#a89c8c", "$description": "Secondary text." },
    "line": { "$type": "color", "$value": "#8a7d6c", "$description": "Row and panel rules." },
    "accent": { "$type": "color", "$value": "#d4b072", "$description": "Brass. Rare fill, not a profit colour." },
    "on-accent": { "$type": "color", "$value": "#1a160f", "$description": "Text on the brass fill." },
    "danger": { "$type": "color", "$value": "#f0b4ac", "$description": "Loss or error text. Pair with a word or a sign." },
    "warning": { "$type": "color", "$value": "#f0b089", "$description": "Caution text. Hotter than the brass accent." },
    "success": { "$type": "color", "$value": "#9dccb0", "$description": "Gain text. Pair with a word or a sign." },
    "focus": { "$type": "color", "$value": "#d4b072", "$description": "Focus ring." },
    "status": {
      "paper": {
        "bg": { "$type": "color", "$value": "#f4efe6", "$description": "Paper label fill. Neutral paper, not brass." },
        "fg": { "$type": "color", "$value": "#141310", "$description": "Paper label text." }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Same family as body. Figures use font.family.mono."
      }
    }
  },
  "elevation": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "No shadow. Separate surfaces with color.line."
    }
  }
}
