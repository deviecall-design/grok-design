{
  "$description": "Eka Noe. Dark terminal for paper and simulated markets. Warm black field, brass accent, monospace figures. Not The Bond.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.status.paper.fg",
        "color.status.paper.bg",
        4.5
      ],
      [
        "color.viz.1",
        "color.bg",
        3
      ],
      [
        "color.viz.1",
        "color.surface",
        3
      ],
      [
        "color.viz.2",
        "color.bg",
        3
      ],
      [
        "color.viz.2",
        "color.surface",
        3
      ],
      [
        "color.viz.3",
        "color.bg",
        3
      ],
      [
        "color.viz.3",
        "color.surface",
        3
      ],
      [
        "color.viz.4",
        "color.bg",
        3
      ],
      [
        "color.viz.4",
        "color.surface",
        3
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(96.2% 0.008 85)",
      "$extensions": {
        "deviecall.dark": "oklch(17.2% 0.012 75)"
      },
      "$description": "Warm ink field. Not The Bond's cream."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(98.2% 0.006 85)",
      "$extensions": {
        "deviecall.dark": "oklch(22.2% 0.012 75)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(24% 0.016 70)",
      "$extensions": {
        "deviecall.dark": "oklch(94% 0.012 85)"
      },
      "$description": "Primary text."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(42% 0.016 70)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.014 80)"
      },
      "$description": "Secondary text."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(56% 0.016 75)",
      "$extensions": {
        "deviecall.dark": "oklch(58% 0.014 75)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(46% 0.08 78)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.075 82)"
      },
      "$description": "Brass, chroma held down so it does not glow."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(97% 0.01 85)",
      "$extensions": {
        "deviecall.dark": "oklch(20% 0.02 75)"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(46% 0.12 28)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.075 27)"
      },
      "$description": "Error text. Pair with a word."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.1 65)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.08 70)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(42% 0.06 155)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.05 155)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(44% 0.035 230)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.03 225)"
      },
      "$description": "Informational text. Low chroma, never the accent."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(46% 0.08 78)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.075 82)"
      },
      "$description": "Focus ring."
    },
    "status": {
      "paper": {
        "bg": {
          "$type": "color",
          "$value": "oklch(24% 0.012 75)",
          "$extensions": {
            "deviecall.dark": "oklch(94% 0.01 85)"
          },
          "$description": "Paper label fill. Neutral paper, not brass."
        },
        "fg": {
          "$type": "color",
          "$value": "oklch(96.2% 0.008 85)",
          "$extensions": {
            "deviecall.dark": "oklch(17.2% 0.012 75)"
          },
          "$description": "Paper label text."
        }
      }
    },
    "viz": {
      "1": {
        "$type": "color",
        "$value": "oklch(46% 0.08 78)",
        "$extensions": {
          "deviecall.dark": "oklch(80% 0.07 82)"
        },
        "$description": "First chart series. Brass."
      },
      "2": {
        "$type": "color",
        "$value": "oklch(44% 0.07 42)",
        "$extensions": {
          "deviecall.dark": "oklch(76% 0.06 45)"
        },
        "$description": "Second chart series. Clay, not a Bond colourway."
      },
      "3": {
        "$type": "color",
        "$value": "oklch(40% 0.045 145)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.04 150)"
        },
        "$description": "Third chart series. Olive."
      },
      "4": {
        "$type": "color",
        "$value": "oklch(42% 0.025 70)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.02 75)"
        },
        "$description": "Fourth chart series. Warm stone."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Same family as body. Figures use font.family.mono."
      }
    }
  },
  "elevation": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "oklch(0% 0 0 / 0)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "No shadow. Separate surfaces with color.line."
    }
  }
}
