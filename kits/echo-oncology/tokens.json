{
  "$description": "Echo Oncology. Clinical, calm, and honest. Measured data and illustrative data are different colours, and research-use is labeled.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.status.research.fg", "color.status.research.bg", 4.5],
      ["color.data.measured", "color.bg", 4.5],
      ["color.data.measured", "color.surface", 4.5],
      ["color.data.illustrative", "color.bg", 4.5],
      ["color.data.illustrative", "color.data.illustrative-surface", 4.5],
      ["color.ink", "color.data.illustrative-surface", 4.5]
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#f4f6f7", "$description": "Cool clinical paper." },
    "surface": { "$type": "color", "$value": "#ffffff", "$description": "Measured-data surface." },
    "ink": { "$type": "color", "$value": "#1a2330", "$description": "Primary text." },
    "muted": { "$type": "color", "$value": "#4e5b6b", "$description": "Secondary text." },
    "line": { "$type": "color", "$value": "#7e8a90", "$description": "Rules between rows and regions." },
    "accent": { "$type": "color", "$value": "#1f4f52", "$description": "Slate teal. Rare. Not a status colour." },
    "on-accent": { "$type": "color", "$value": "#f4f6f7", "$description": "Text on the teal fill." },
    "danger": { "$type": "color", "$value": "#8d2c22", "$description": "Text for a defined clinical risk, never decoration." },
    "warning": { "$type": "color", "$value": "#7a4e0d", "$description": "Caution text." },
    "success": { "$type": "color", "$value": "#21543c", "$description": "Confirmed text." },
    "focus": { "$type": "color", "$value": "#1f4f52", "$description": "Focus ring." },
    "status": {
      "research": {
        "bg": { "$type": "color", "$value": "#1a2330", "$description": "Research-use label fill." },
        "fg": { "$type": "color", "$value": "#f4f6f7", "$description": "Research-use label text." }
      }
    },
    "data": {
      "measured": { "$type": "color", "$value": "#1a2330", "$description": "Marks and text for measured data only." },
      "illustrative": { "$type": "color", "$value": "#5c4a1e", "$description": "Marks and text for illustrative data only." },
      "illustrative-surface": { "$type": "color", "$value": "#f3ead6", "$description": "Background behind illustrative content." }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Same family as body. No display costume."
      }
    }
  }
}
