{
  "$description": "Echo Oncology. Clinical, calm, and honest. Measured data and illustrative data are different colours, and research-use is labeled.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.status.research.fg",
        "color.status.research.bg",
        4.5
      ],
      [
        "color.data.measured",
        "color.bg",
        4.5
      ],
      [
        "color.data.measured",
        "color.surface",
        4.5
      ],
      [
        "color.data.illustrative",
        "color.bg",
        4.5
      ],
      [
        "color.data.illustrative",
        "color.data.illustrative-surface",
        4.5
      ],
      [
        "color.ink",
        "color.data.illustrative-surface",
        4.5
      ],
      [
        "color.viz.1",
        "color.bg",
        3
      ],
      [
        "color.viz.1",
        "color.surface",
        3
      ],
      [
        "color.viz.2",
        "color.bg",
        3
      ],
      [
        "color.viz.2",
        "color.surface",
        3
      ],
      [
        "color.viz.3",
        "color.bg",
        3
      ],
      [
        "color.viz.3",
        "color.surface",
        3
      ],
      [
        "color.viz.4",
        "color.bg",
        3
      ],
      [
        "color.viz.4",
        "color.surface",
        3
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(97.2% 0.005 250)",
      "$extensions": {
        "deviecall.dark": "oklch(18.5% 0.012 250)"
      },
      "$description": "Cool clinical paper."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(99.2% 0.003 250)",
      "$extensions": {
        "deviecall.dark": "oklch(23% 0.012 250)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(26% 0.02 255)",
      "$extensions": {
        "deviecall.dark": "oklch(94% 0.008 250)"
      },
      "$description": "Primary text."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(42% 0.018 255)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.012 250)"
      },
      "$description": "Secondary text."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(58% 0.012 250)",
      "$extensions": {
        "deviecall.dark": "oklch(60% 0.012 250)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(40% 0.048 195)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.05 195)"
      },
      "$description": "Slate teal. Rare. Not a status colour."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(97.2% 0.005 250)",
      "$extensions": {
        "deviecall.dark": "oklch(20% 0.02 195)"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(46% 0.12 28)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.08 27)"
      },
      "$description": "Error text. Pair with a word."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.1 72)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.075 75)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(42% 0.06 160)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.05 165)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(44% 0.04 230)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.035 230)"
      },
      "$description": "Informational text. Low chroma, never the accent."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(40% 0.048 195)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.05 195)"
      },
      "$description": "Focus ring."
    },
    "data": {
      "measured": {
        "$type": "color",
        "$value": "oklch(26% 0.02 255)",
        "$extensions": {
          "deviecall.dark": "oklch(94% 0.008 250)"
        },
        "$description": "Measured marks only."
      },
      "illustrative": {
        "$type": "color",
        "$value": "oklch(40% 0.06 70)",
        "$extensions": {
          "deviecall.dark": "oklch(82% 0.05 75)"
        },
        "$description": "Illustrative marks only."
      },
      "illustrative-surface": {
        "$type": "color",
        "$value": "oklch(93.5% 0.03 85)",
        "$extensions": {
          "deviecall.dark": "oklch(32% 0.03 75)"
        },
        "$description": "Warm ground behind illustrative content."
      }
    },
    "status": {
      "research": {
        "bg": {
          "$type": "color",
          "$value": "oklch(26% 0.02 255)",
          "$extensions": {
            "deviecall.dark": "oklch(94% 0.008 200)"
          },
          "$description": "Research-use label fill."
        },
        "fg": {
          "$type": "color",
          "$value": "oklch(97.2% 0.005 250)",
          "$extensions": {
            "deviecall.dark": "oklch(20% 0.015 250)"
          },
          "$description": "Research-use label text."
        }
      }
    },
    "viz": {
      "1": {
        "$type": "color",
        "$value": "oklch(40% 0.048 195)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.05 195)"
        },
        "$description": "Chart series. Teal."
      },
      "2": {
        "$type": "color",
        "$value": "oklch(36% 0.03 255)",
        "$extensions": {
          "deviecall.dark": "oklch(80% 0.025 250)"
        },
        "$description": "Chart series. Ink."
      },
      "3": {
        "$type": "color",
        "$value": "oklch(42% 0.055 70)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.045 72)"
        },
        "$description": "Chart series. Clay, for a non-measured comparison."
      },
      "4": {
        "$type": "color",
        "$value": "oklch(42% 0.03 210)",
        "$extensions": {
          "deviecall.dark": "oklch(78% 0.03 210)"
        },
        "$description": "Chart series. Slate."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Same family as body. No display costume."
      }
    }
  }
}
