{
  "$description": "The Bond. Pet wellness. Warm paper, serif headings, sage accent, a little clay. Fully separate from Eka Noe.",
  "$extensions": {
    "deviecall.contrastPairs": [
      [
        "color.clay",
        "color.bg",
        4.5
      ],
      [
        "color.clay",
        "color.surface",
        4.5
      ],
      [
        "color.on-accent",
        "color.clay",
        4.5
      ]
    ]
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "oklch(96.6% 0.018 75)",
      "$extensions": {
        "deviecall.dark": "oklch(23% 0.02 65)"
      },
      "$description": "Warmer cream than Eka Noe's sand. Dark mode is a brown room, not a terminal."
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(98.4% 0.012 75)",
      "$extensions": {
        "deviecall.dark": "oklch(27.5% 0.02 65)"
      },
      "$description": "Raised surface."
    },
    "ink": {
      "$type": "color",
      "$value": "oklch(26% 0.018 55)",
      "$extensions": {
        "deviecall.dark": "oklch(94% 0.012 80)"
      },
      "$description": "Primary text."
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(42% 0.018 55)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.016 70)"
      },
      "$description": "Secondary text."
    },
    "line": {
      "$type": "color",
      "$value": "oklch(58% 0.016 70)",
      "$extensions": {
        "deviecall.dark": "oklch(62% 0.014 65)"
      },
      "$description": "Structural rules."
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(40% 0.05 155)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.05 155)"
      },
      "$description": "Sage. The Bond's accent. Eka Noe stays brass."
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(96.8% 0.012 80)",
      "$extensions": {
        "deviecall.dark": "oklch(24% 0.02 155)"
      }
    },
    "clay": {
      "$type": "color",
      "$value": "oklch(44% 0.08 42)",
      "$extensions": {
        "deviecall.dark": "oklch(74% 0.07 42)"
      },
      "$description": "Secondary material. Small moments."
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(46% 0.12 28)",
      "$extensions": {
        "deviecall.dark": "oklch(78% 0.08 27)"
      },
      "$description": "Error text. Pair with a word."
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(48% 0.1 70)",
      "$extensions": {
        "deviecall.dark": "oklch(82% 0.08 75)"
      },
      "$description": "Caution text. Pair with a word."
    },
    "success": {
      "$type": "color",
      "$value": "oklch(40% 0.06 158)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.05 158)"
      },
      "$description": "Confirmed text. Pair with a word."
    },
    "info": {
      "$type": "color",
      "$value": "oklch(44% 0.035 230)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.03 225)"
      },
      "$description": "Informational text. Low chroma, never the accent."
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(40% 0.05 155)",
      "$extensions": {
        "deviecall.dark": "oklch(80% 0.05 155)"
      },
      "$description": "Focus ring."
    }
  }
}
