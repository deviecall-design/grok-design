{
  "$description": "The Bond. Pet wellness. Warm paper, serif headings, sage accent, a little clay. Fully separate from Eka Noe.",
  "$extensions": {
    "deviecall.contrastPairs": [
      ["color.clay", "color.bg", 4.5],
      ["color.clay", "color.surface", 4.5],
      ["color.on-accent", "color.clay", 4.5]
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#f7f2ea", "$description": "Warm paper." },
    "surface": { "$type": "color", "$value": "#fffaf4", "$description": "Card surface. Still paper." },
    "ink": { "$type": "color", "$value": "#2c241c", "$description": "Primary text." },
    "muted": { "$type": "color", "$value": "#5e5348", "$description": "Secondary text." },
    "line": { "$type": "color", "$value": "#82796f", "$description": "Rules." },
    "accent": { "$type": "color", "$value": "#3e6248", "$description": "Sage. The primary accent." },
    "on-accent": { "$type": "color", "$value": "#f7f2ea", "$description": "Text on sage, and on clay fills." },
    "clay": { "$type": "color", "$value": "#7a4636", "$description": "Secondary material colour. Small moments only." },
    "danger": { "$type": "color", "$value": "#8d2c22", "$description": "Error text." },
    "warning": { "$type": "color", "$value": "#7a4e0d", "$description": "Caution text." },
    "success": { "$type": "color", "$value": "#21543c", "$description": "Confirmed text." },
    "focus": { "$type": "color", "$value": "#3e6248", "$description": "Focus ring." }
  }
}
